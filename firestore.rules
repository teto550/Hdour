rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function servantData() {
      return get(/databases/$(database)/documents/servants/$(request.auth.uid)).data;
    }

    function isApproved() {
      return isSignedIn() && servantData().status == 'approved';
    }

    function isAdmin() {
      return isSignedIn() && servantData().role == 'admin';
    }

    // ---- servants (accounts / registration) ----
    match /servants/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role   == resource.data.role
            && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // ---- everything else: only approved servants ----
    match /students/{id} {
      allow read, write: if isApproved();
    }

    match /attendance/{id} {
      allow read, write: if isApproved();
    }

    match /verses/{id} {
      allow read, write: if isApproved();
    }

    match /messageTemplates/{id} {
      allow read, write: if isApproved();
    }

    match /activityLog/{id} {
      allow read, create: if isApproved();
      allow update, delete: if isAdmin();
    }
  }
}
